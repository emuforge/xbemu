<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What xbemu.app asks of the system when signed with the hardened runtime:
     the CPU backend writes and runs host code (MAP_JIT, crates/xb-cpu-interp
     src/jit). The ad-hoc signature of a pre-release has no hardened runtime
     and needs none of this; a notarized release would. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
